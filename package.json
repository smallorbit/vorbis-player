{
  "name": "vap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "tsx scripts/check-node-modules.ts && vitest",
    "test:ui": "tsx scripts/check-node-modules.ts && vitest --ui",
    "test:run": "tsx scripts/check-node-modules.ts && vitest run",
    "test:coverage": "tsx scripts/check-node-modules.ts && vitest run --coverage",
    "deploy": "tsx scripts/deploy.ts --prod",
    "deploy:preview": "tsx scripts/deploy.ts",
    "favicon": "tsx scripts/generate-favicon.ts",
    "knip": "knip",
    "check:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.app.json src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview:e2e": "npm run build:e2e && vite preview",
    "build:e2e": "VITE_MOCK_PROVIDER=true VITE_LASTFM_API_KEY=e2e-stub-key npm run build",
    "capture": "playwright test --config playwright/capture/capture.config.ts --project desktop --project mobile",
    "capture:desktop": "playwright test --config playwright/capture/capture.config.ts --project desktop",
    "capture:mobile": "playwright test --config playwright/capture/capture.config.ts --project mobile",
    "snapshot:spotify": "tsx scripts/snapshot-spotify.ts",
    "snapshot:dropbox": "tsx scripts/snapshot-dropbox.ts",
    "audit:ci": "audit-ci --config audit-ci.jsonc"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle-group": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "debug": "^4.4.3",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "styled-components": "^6.1.12",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.10.13",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "audit-ci": "^7.1.0",
    "eslint": "^9.25.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "madge": "^8.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "knip": "^5.84.1",
    "postcss": "^8.5.10",
    "sharp": "^0.35.4",
    "sharp-ico": "^0.1.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
